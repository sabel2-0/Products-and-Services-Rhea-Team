@model MyAspNetApp.Models.ChallengesPageViewModel
@{
  var featured = Model.FeaturedChallenge;
  var hasFeatured = featured is not null;

  // Voucher helpers (sourced from Model.Vouchers if you add the property, otherwise safe-null)
  var allVouchers    = Model.Vouchers ?? new();
  var activeVouchers = allVouchers.Where(v => !v.IsUsed && !v.IsExpired).ToList();
  var usedVouchers   = allVouchers.Where(v => v.IsUsed).ToList();
  var expiredVouchers= allVouchers.Where(v => v.IsExpired && !v.IsUsed).ToList();
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap');
.pg,.pg *{box-sizing:border-box;margin:0;padding:0}
.pg{font-family:'DM Sans',sans-serif;background:#fff;color:#000;padding:2.5rem 2rem 4rem}

/* ── Header ── */
.pg .pg-header{border-bottom:1.5px solid #000;padding-bottom:1rem;margin-bottom:2rem;display:flex;align-items:baseline;justify-content:space-between}
.pg .pg-header h1{font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:0.04em;line-height:1;color:#000}
.pg .pg-header-sub{font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#999;font-weight:400}

/* ── Tabs ── */
.pg .pg-tabs{display:flex;gap:0;border-bottom:1.5px solid #e8e8e8;margin-bottom:3rem}
.pg .pg-tab{font-size:13px;letter-spacing:0.1em;text-transform:uppercase;font-weight:500;padding:0.65rem 1.4rem 0.65rem 0;border:none;background:none;color:#aaa;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1.5px;transition:color .15s}
.pg .pg-tab:hover{color:#555}
.pg .pg-tab.active{color:#000;border-bottom:2px solid #000}

/* ── Tab Panels ── */
.pg .tab-panel{display:none}
.pg .tab-panel.active{display:block}

/* ── Hero Stats ── */
.pg .hero{display:grid;grid-template-columns:1fr 1px 1fr 1px 1fr;gap:0;border:1px solid #e8e8e8;margin-bottom:3rem;background:#fff;padding:0 !important;height:auto !important;min-height:0 !important}
.pg .hero-stat{padding:1.5rem 1.25rem;text-align:center;min-height:0 !important}
.pg .hero-divider{background:#e8e8e8}
.pg .hero-stat-num{font-family:'Bebas Neue',sans-serif;font-size:48px;letter-spacing:0.02em;line-height:1;color:#000}
.pg .hero-stat-label{font-size:13px;letter-spacing:0.11em;text-transform:uppercase;color:#aaa;margin-top:6px;font-weight:400}

/* ── Section Row ── */
.pg .section-row{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:1.25rem}
.pg .section-label{font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#aaa;font-weight:400}
.pg .section-tag{font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#000;font-weight:500;border-bottom:1px solid #000;padding-bottom:1px}
.pg .section-row.upcoming-head .section-label{font-size:16px;letter-spacing:0.08em;color:#111;font-weight:700}
.pg .section-row.upcoming-head .section-tag{font-size:14px;letter-spacing:0.08em;color:#111;font-weight:700}
.pg .section-row.leaderboard-head .section-label{font-size:16px;letter-spacing:0.08em;color:#111;font-weight:700}
.pg .section-row.leaderboard-head .section-tag{font-size:14px;letter-spacing:0.08em;color:#111;font-weight:700}

/* ── Featured Challenge ── */
.pg .featured{display:grid;grid-template-columns:1.35fr 1fr;gap:1px;background:#e8e8e8;margin-bottom:1px}
.pg .feat-main{background:#000;padding:2.5rem 2rem;position:relative;overflow:hidden}
.pg .feat-main.has-banner{background-size:cover;background-position:center;background-repeat:no-repeat}
.pg .feat-main-ghost{position:absolute;bottom:-10px;right:-8px;font-family:'Bebas Neue',sans-serif;font-size:120px;color:rgba(255,255,255,0.05);line-height:1;user-select:none;pointer-events:none}
.pg .feat-badge{display:inline-block;background:#fff;color:#000;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;padding:4px 10px;font-weight:500;margin-bottom:1.25rem}
.pg .feat-main h2{font-family:'Bebas Neue',sans-serif;font-size:38px;letter-spacing:0.03em;line-height:1.05;color:#fff;margin-bottom:1rem}
.pg .feat-main p{font-size:15px;color:rgba(255,255,255,0.68);line-height:1.65;font-weight:300;max-width:320px;margin-bottom:1.75rem}
.pg .feat-meta{display:flex;gap:1.5rem}
.pg .feat-meta-item{display:flex;flex-direction:column;gap:3px}
.pg .feat-meta-val{font-size:14px;font-weight:500;color:#fff}
.pg .feat-meta-key{font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.48);font-weight:400}
.pg .join-challenge-btn{display:inline-flex;align-items:center;justify-content:center;margin-top:1.35rem;padding:0.68rem 1.1rem;border:1px solid #fff;background:#fff;color:#000;text-transform:uppercase;letter-spacing:0.09em;font-size:11px;font-weight:700;text-decoration:none;transition:all .18s ease}
.pg .join-challenge-btn:hover{background:transparent;color:#fff}
.pg .feat-side{background:#fff;display:flex;flex-direction:column}
.pg .feat-side-top{padding:1.75rem 1.5rem;border-bottom:1px solid #e8e8e8;flex:1}
.pg .feat-side-top h3{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:0.03em;margin-bottom:0.5rem;color:#000}
.pg .feat-side-top p{font-size:14px;color:#666;line-height:1.65;font-weight:300}
.pg .feat-side-stat{padding:1.25rem 1.5rem;background:#f9f9f9;border-bottom:1px solid #e8e8e8}
.pg .feat-side-stat-row{display:flex;justify-content:space-between;align-items:center}
.pg .feat-side-stat span:first-child{font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#999;font-weight:400}
.pg .feat-side-stat span:last-child{font-size:14px;font-weight:500;color:#000}
.pg .feat-progress{padding:1.25rem 1.5rem}
.pg .feat-progress-label{display:flex;justify-content:space-between;margin-bottom:8px}
.pg .feat-progress-label span{font-size:12px;color:#999;font-weight:400}
.pg .feat-progress-bar{height:3px;background:#e8e8e8;width:100%}
.pg .feat-progress-fill{height:3px;background:#000;width:38%}

/* ── Challenge Cards ── */
.pg .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#e8e8e8;margin-bottom:3rem}
.pg .card{background:#fff;padding:1.75rem 1.5rem;position:relative;transition:background 0.15s;cursor:default}
.pg .card:hover{background:#f7f7f7}
.pg .card-banner{margin:-1.75rem -1.5rem 1rem;height:120px;overflow:hidden;background:#111}
.pg .card-banner img{width:100%;height:100%;object-fit:cover;display:block}
.pg .card-accent{position:absolute;top:0;left:0;width:2px;height:100%;background:#000}
.pg .card-meta-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
.pg .card-badge{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#aaa;font-weight:500}
.pg .upcoming-grid .card-badge{font-size:13px;letter-spacing:0.08em;color:#6f6f6f;font-weight:700}
.pg .card-diff{font-size:11px;letter-spacing:0.1em;text-transform:uppercase;padding:3px 8px;font-weight:500}
.pg .diff-easy{background:#f0f0f0;color:#888}
.pg .diff-med{background:#e0e0e0;color:#555}
.pg .diff-hard{background:#111;color:#fff}
.pg .card h3{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:0.04em;margin-bottom:0.6rem;color:#000;line-height:1.1}
.pg .card p{font-size:14px;color:#666;line-height:1.65;font-weight:300;margin-bottom:1.25rem}
.pg .card-footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #f0f0f0;padding-top:1rem}
.pg .card-footer-stat{font-size:12px;color:#999;font-weight:400}
.pg .card-footer-stat strong{color:#000;font-weight:500}
.pg .card-num{font-family:'Bebas Neue',sans-serif;font-size:36px;color:#f2f2f2;line-height:1;user-select:none}

/* ── Leaderboard ── */
.pg .leaderboard{border:1px solid #e8e8e8}
.pg .lb-row{display:grid;grid-template-columns:40px 1fr repeat(3,80px);align-items:center;padding:0.9rem 1.25rem;border-bottom:1px solid #f0f0f0;transition:background 0.1s}
.pg .lb-row:last-child{border-bottom:none}
.pg .lb-row:hover{background:#fafafa}
.pg .lb-rank{font-family:'Bebas Neue',sans-serif;font-size:20px;color:#ccc;text-align:center}
.pg .lb-rank.top{color:#000}
.pg .lb-name{font-size:15px;font-weight:500;color:#000}
.pg .lb-handle{font-size:13px;color:#999;font-weight:400;margin-top:1px}
.pg .lb-val{font-size:14px;color:#555;text-align:right;font-weight:400}
.pg .lb-val.bold{font-weight:500;color:#000}
.pg .lb-header .lb-rank,.pg .lb-header .lb-val,.pg .lb-header .lb-name{font-size:11px;letter-spacing:0.11em;text-transform:uppercase;color:#aaa;font-weight:400;font-family:'DM Sans',sans-serif}
.pg .lb-header{background:#fafafa;border-bottom:1px solid #e8e8e8}
.pg .lb-header:hover{background:#fafafa}
.pg .lb-avatar{width:30px;height:30px;border-radius:50%;background:#000;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;color:#fff;margin-right:10px;flex-shrink:0}
.pg .lb-name-wrap{display:flex;align-items:center}

/* ── Empty State ── */
.pg .empty-state{border:1px solid #e8e8e8;padding:1.5rem;color:#777;font-size:14px;background:#fff}

/* ═══════════════════════════════════════════════════
   VOUCHERS
═══════════════════════════════════════════════════ */

/* Hero (4 cols for vouchers) */
.pg .hero-4{display:grid;grid-template-columns:1fr 1px 1fr 1px 1fr 1px 1fr;gap:0;border:1px solid #e8e8e8;margin-bottom:3rem;background:#fff}

/* Voucher grid */
.pg .voucher-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#e8e8e8;margin-bottom:3rem}

/* Voucher card */
.pg .voucher-card{background:#fff;position:relative;overflow:hidden;transition:background 0.15s;cursor:default;display:flex;flex-direction:column}
.pg .voucher-card:hover{background:#f7f7f7}
.pg .voucher-card::before,.pg .voucher-card::after{content:'';position:absolute;width:16px;height:16px;border-radius:50%;background:#e8e8e8;top:50%;transform:translateY(-50%);z-index:2}
.pg .voucher-card::before{left:-8px}
.pg .voucher-card::after{right:-8px}

.pg .voucher-stub{width:4px;position:absolute;top:0;left:0;bottom:0}
.pg .stub-active{background:#000}
.pg .stub-used{background:#bbb}
.pg .stub-expired{background:#e0e0e0}

.pg .voucher-body{padding:1.75rem 1.5rem 1.5rem 1.75rem;flex:1;display:flex;flex-direction:column}
.pg .voucher-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
.pg .voucher-type{font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#aaa;font-weight:500}
.pg .status-pill{font-size:10px;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;padding:3px 9px}
.pg .pill-active{background:#000;color:#fff}
.pg .pill-used{background:#f0f0f0;color:#888}
.pg .pill-expired{background:#f5f5f5;color:#bbb}

.pg .voucher-value{font-family:'Bebas Neue',sans-serif;font-size:44px;letter-spacing:0.03em;line-height:1;color:#000;margin-bottom:4px}
.pg .voucher-card.is-used .voucher-value,.pg .voucher-card.is-expired .voucher-value{color:#ccc}
.pg .voucher-title{font-size:14px;font-weight:500;color:#333;margin-bottom:0.5rem}
.pg .voucher-card.is-used .voucher-title,.pg .voucher-card.is-expired .voucher-title{color:#aaa}
.pg .voucher-desc{font-size:13px;color:#888;line-height:1.6;font-weight:300;flex:1;margin-bottom:1.25rem}

.pg .voucher-tear{border:none;border-top:1.5px dashed #e8e8e8;margin:0 -1.5rem 1rem -1.75rem}
.pg .voucher-footer{display:flex;justify-content:space-between;align-items:center}
.pg .voucher-code{font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:0.2em;color:#000}
.pg .voucher-card.is-used .voucher-code,.pg .voucher-card.is-expired .voucher-code{color:#ccc}
.pg .voucher-expiry{font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#bbb;font-weight:400}
.pg .expiry-soon{color:#c00}

/* stamp overlay */
.pg .stamp{position:absolute;top:50%;right:1.5rem;transform:translateY(-50%) rotate(-12deg);font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:0.15em;color:rgba(0,0,0,0.08);border:3px solid rgba(0,0,0,0.07);padding:4px 10px;pointer-events:none;user-select:none;white-space:nowrap}

/* Voucher history table */
.pg .history-table{border:1px solid #e8e8e8;margin-bottom:3rem}
.pg .ht-row{display:grid;grid-template-columns:1fr 100px 140px 110px;align-items:center;padding:0.9rem 1.25rem;border-bottom:1px solid #f0f0f0;transition:background 0.1s}
.pg .ht-row:last-child{border-bottom:none}
.pg .ht-row:hover{background:#fafafa}
.pg .ht-header{background:#fafafa;border-bottom:1px solid #e8e8e8}
.pg .ht-header:hover{background:#fafafa}
.pg .ht-header span{font-size:11px;letter-spacing:0.11em;text-transform:uppercase;color:#aaa;font-weight:400}
.pg .ht-name{font-size:14px;font-weight:500;color:#000}
.pg .ht-sub{font-size:12px;color:#bbb;margin-top:2px;font-weight:300}
.pg .ht-code{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:0.15em;color:#999}
.pg .ht-date{font-size:13px;color:#999;text-align:right}
.pg .ht-badge{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;font-weight:600;padding:3px 8px;text-align:center;justify-self:end}
.pg .badge-used{background:#f0f0f0;color:#888}
.pg .badge-expired{background:#f5f5f5;color:#bbb}

/* empty state variant */
.pg .empty-state-center{border:1px solid #e8e8e8;padding:2.5rem 1.5rem;color:#aaa;font-size:14px;background:#fff;text-align:center;margin-bottom:3rem}
.pg .empty-icon{font-family:'Bebas Neue',sans-serif;font-size:56px;letter-spacing:0.04em;color:#e8e8e8;display:block;margin-bottom:0.5rem}
</style>

<div class="pg">

  <!-- ══ Header ══ -->
  <div class="pg-header">
    <h1 id="pg-title">Challenges</h1>
    <span class="pg-header-sub" id="pg-sub">@Model.SeasonLabel &nbsp;·&nbsp; @Model.ActiveCount Active</span>
  </div>

  <!-- ══ Tabs ══ -->
  <div class="pg-tabs">
    <button class="pg-tab active" onclick="switchTab('challenges', this)">Challenges</button>
    <button class="pg-tab" onclick="switchTab('vouchers', this)">My Vouchers</button>
  </div>

  <!-- ══════════════════════════════════════
       TAB: CHALLENGES
  ══════════════════════════════════════ -->
  <div class="tab-panel active" id="tab-challenges">

    <div class="hero">
      <div class="hero-stat">
        <div class="hero-stat-num">@Model.TotalParticipants.ToString("N0")</div>
        <div class="hero-stat-label">Runners Competing</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@Model.TotalGoalKm.ToString("N1")</div>
        <div class="hero-stat-label">Total Goal KM</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@Model.DaysUntilNextDrop</div>
        <div class="hero-stat-label">Days Until Next Drop</div>
      </div>
    </div>

    <div class="section-row">
      <span class="section-label">Featured challenge</span>
      <span class="section-tag">Live now</span>
    </div>

    @if (hasFeatured)
    {
    <div class="featured" style="margin-bottom:3rem">
      <div class="feat-main @(featured!.HasBannerImage ? "has-banner" : string.Empty)" style="@(featured!.HasBannerImage ? $"background-image:linear-gradient(rgba(0,0,0,.56),rgba(0,0,0,.56)),url('/Home/ChallengeBanner/{featured.ChallengeId}')" : string.Empty)">
        <div class="feat-main-ghost">RUN</div>
        <span class="feat-badge">&#9679; Live</span>
        <h2>@featured!.Title</h2>
        <p>@featured.Description</p>
        <div class="feat-meta">
          <div class="feat-meta-item">
            <span class="feat-meta-val">@featured.DurationDays days</span>
            <span class="feat-meta-key">Duration</span>
          </div>
          <div class="feat-meta-item">
            <span class="feat-meta-val">@featured.GoalKm.ToString("N1") km</span>
            <span class="feat-meta-key">Goal</span>
          </div>
          <div class="feat-meta-item">
            <span class="feat-meta-val">@featured.TotalParticipants.ToString("N0")</span>
            <span class="feat-meta-key">Joined</span>
          </div>
        </div>
        <a href="#" class="join-challenge-btn">Join Challenge</a>
      </div>
      <div class="feat-side">
        <div class="feat-side-top">
          <p class="card-badge" style="margin-bottom:8px">Reward</p>
          <h3>@featured.ActivityType</h3>
          <p>@featured.Prizes</p>
        </div>
        <div class="feat-side-stat">
          <div class="feat-side-stat-row">
            <span>Completion rate</span>
            <span>@featured.CompletionPercent.ToString("N0")%</span>
          </div>
        </div>
        <div class="feat-side-stat" style="border-bottom:none">
          <div class="feat-side-stat-row">
            <span>Completed</span>
            <span>@featured.TotalCompleted.ToString("N0")</span>
          </div>
        </div>
        <div class="feat-progress">
          <div class="feat-progress-label">
            <span>Community progress</span>
            <span>@featured.CompletionPercent.ToString("N0")% avg completion</span>
          </div>
          <div class="feat-progress-bar"><div class="feat-progress-fill" style="width:@featured.CompletionPercent%"></div></div>
        </div>
      </div>
    </div>
    }
    else
    {
    <div class="empty-state" style="margin-bottom:3rem">No challenges found in database yet.</div>
    }

    <div class="section-row upcoming-head">
      <span class="section-label">More challenges</span>
      <span class="section-tag">From database</span>
    </div>

    @if (Model.UpcomingChallenges.Any())
    {
    <div class="grid3 upcoming-grid">
      @for (var i = 0; i < Model.UpcomingChallenges.Count; i++)
      {
        var item = Model.UpcomingChallenges[i];
        var isLive =
          (item.StartDate <= DateTime.Now && item.EndDate >= DateTime.Now) ||
          string.Equals(item.Status, "live", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(item.Status, "active", StringComparison.OrdinalIgnoreCase);
      <article class="card">
        <div class="card-accent"></div>
        @if (item.HasBannerImage)
        {
        <div class="card-banner">
          <img src="/Home/ChallengeBanner/@item.ChallengeId" alt="@item.Title banner" loading="lazy" />
        </div>
        }
        <div class="card-meta-row">
          <span class="card-badge">@(isLive ? "Live now" : $"Coming {item.StartDate:MMM d}")</span>
          <span class="card-diff @item.DifficultyCssClass">@item.DifficultyLabel</span>
        </div>
        <h3>@item.Title</h3>
        <p>@item.Description</p>
        <div class="card-footer">
          <span class="card-footer-stat">Duration <strong>@item.DurationDays days</strong></span>
          <span class="card-num">@((i + 1).ToString("D2"))</span>
        </div>
      </article>
      }
    </div>
    }
    else
    {
    <div class="empty-state" style="margin-bottom:3rem">No additional challenges available.</div>
    }

    <div class="section-row leaderboard-head">
      <span class="section-label">Challenge Performance</span>
      <span class="section-tag">From Database</span>
    </div>

    @if (Model.TopChallenges.Any())
    {
    <div class="leaderboard">
      <div class="lb-row lb-header">
        <span class="lb-rank">#</span>
        <span class="lb-name">Challenge</span>
        <span class="lb-val">Goal KM</span>
        <span class="lb-val">Completed</span>
        <span class="lb-val">Participants</span>
      </div>
      @for (var i = 0; i < Model.TopChallenges.Count; i++)
      {
        var row = Model.TopChallenges[i];
      <div class="lb-row">
        <span class="lb-rank @(i < 3 ? "top" : string.Empty)">@(i + 1)</span>
        <div class="lb-name-wrap"><span class="lb-avatar">@row.ActivityType[..Math.Min(2, row.ActivityType.Length)].ToUpperInvariant()</span><div><div class="lb-name">@row.Title</div><div class="lb-handle">@row.Status</div></div></div>
        <span class="lb-val bold">@row.GoalKm.ToString("N1") km</span>
        <span class="lb-val">@row.TotalCompleted.ToString("N0")</span>
        <span class="lb-val">@row.TotalParticipants.ToString("N0")</span>
      </div>
      }
    </div>
    }
    else
    {
    <div class="empty-state">No challenge performance data available.</div>
    }

  </div><!-- /tab-challenges -->


  <!-- ══════════════════════════════════════
       TAB: MY VOUCHERS
  ══════════════════════════════════════ -->
  <div class="tab-panel" id="tab-vouchers">

    <!-- Stats bar (4 cols) -->
    <div class="hero-4 hero">
      <div class="hero-stat">
        <div class="hero-stat-num">@activeVouchers.Count</div>
        <div class="hero-stat-label">Active</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@usedVouchers.Count</div>
        <div class="hero-stat-label">Redeemed</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@expiredVouchers.Count</div>
        <div class="hero-stat-label">Expired</div>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stat">
        <div class="hero-stat-num">@Model.TotalSavedDisplay</div>
        <div class="hero-stat-label">Total Saved</div>
      </div>
    </div>

    <!-- Active vouchers -->
    <div class="section-row">
      <span class="section-label" style="font-size:16px;letter-spacing:0.08em;color:#111;font-weight:700;">Active Vouchers</span>
      <span class="section-tag">Ready to use</span>
    </div>

    @if (activeVouchers.Any())
    {
    <div class="voucher-grid">
      @foreach (var v in activeVouchers)
      {
        var expiringSoon = v.ExpiryDate <= DateTime.Now.AddDays(7);
      <div class="voucher-card">
        <div class="voucher-stub stub-active"></div>
        <div class="voucher-body">
          <div class="voucher-top">
            <span class="voucher-type">@v.VoucherType</span>
            <span class="status-pill pill-active">&#9679; Active</span>
          </div>
          <div class="voucher-value">@v.DisplayValue</div>
          <div class="voucher-title">@v.Title</div>
          <div class="voucher-desc">@v.Description</div>
          <hr class="voucher-tear" />
          <div class="voucher-footer">
            <span class="voucher-code">@v.Code</span>
            <span class="voucher-expiry @(expiringSoon ? "expiry-soon" : string.Empty)">Exp @v.ExpiryDate.ToString("MMM d, yyyy")</span>
          </div>
        </div>
      </div>
      }
    </div>
    }
    else
    {
    <div class="empty-state-center">
      <span class="empty-icon">NONE</span>
      <p>No active vouchers — earn them by completing challenges</p>
    </div>
    }

    <!-- History (used + expired) -->
    @if (usedVouchers.Any() || expiredVouchers.Any())
    {
    <div class="section-row" style="margin-top:0.5rem">
      <span class="section-label" style="font-size:16px;letter-spacing:0.08em;color:#111;font-weight:700;">Voucher History</span>
      <span class="section-tag">Used &amp; Expired</span>
    </div>

    <div class="history-table">
      <div class="ht-row ht-header">
        <span>Voucher</span>
        <span>Code</span>
        <span style="text-align:right">Date</span>
        <span style="text-align:right">Status</span>
      </div>
      @foreach (var v in usedVouchers)
      {
      <div class="ht-row">
        <div>
          <div class="ht-name">@v.Title <span style="font-size:12px;color:#bbb;font-weight:300">· @v.DisplayValue</span></div>
          <div class="ht-sub">@v.VoucherType</div>
        </div>
        <span class="ht-code">@v.Code</span>
        <span class="ht-date">@v.RedeemedDate?.ToString("MMM d, yyyy")</span>
        <span class="ht-badge badge-used">Redeemed</span>
      </div>
      }
      @foreach (var v in expiredVouchers)
      {
      <div class="ht-row">
        <div>
          <div class="ht-name" style="color:#ccc">@v.Title <span style="font-size:12px;font-weight:300">· @v.DisplayValue</span></div>
          <div class="ht-sub" style="color:#ddd">@v.VoucherType</div>
        </div>
        <span class="ht-code" style="color:#ddd">@v.Code</span>
        <span class="ht-date" style="color:#ddd">Exp @v.ExpiryDate.ToString("MMM d, yyyy")</span>
        <span class="ht-badge badge-expired">Expired</span>
      </div>
      }
    </div>
    }

  </div><!-- /tab-vouchers -->

</div><!-- /pg -->

<script>
  function switchTab(name, btn) {
    // panels
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    // buttons
    document.querySelectorAll('.pg-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    // header text
    var titles   = { challenges: 'Challenges', vouchers: 'My Vouchers' };
    var subtitles = {
      challenges: '@Model.SeasonLabel · @Model.ActiveCount Active',
      vouchers:   '@Model.SeasonLabel · @activeVouchers.Count Active'
    };
    document.getElementById('pg-title').textContent = titles[name];
    document.getElementById('pg-sub').textContent   = subtitles[name];
  }
</script>
